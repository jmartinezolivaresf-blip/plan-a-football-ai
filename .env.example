# Copy to .env and fill in locally. Never commit real values (.env is git-ignored).

# Engine used by the standalone MCP server: mock (fixtures) or real (public season, run `make season` first).
ENGINE=mock

# MCP server (loopback only; the server refuses other hosts)
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Agents: offline (deterministic rules, no Azure) or foundry (Microsoft Foundry models). See docs/FOUNDRY.md.
AGENTS_MODE=offline

# Microsoft Foundry. Auth is Entra ID through `az login --tenant <FOUNDRY_TENANT_ID>`; no API keys.
# Project endpoint, from the Foundry portal: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model DEPLOYMENT names (not model names). Analyst uses SMALL; manager uses LARGE (defaults to SMALL).
FOUNDRY_MODEL_SMALL=
FOUNDRY_MODEL_LARGE=
# Directory (tenant) id of the subscription that hosts the project. Corporate tenants are refused by the code.
FOUNDRY_TENANT_ID=
# Optional: more tenant ids to refuse, comma separated.
FOUNDRY_DENY_TENANTS=

# Azure deployment scripts (infra/). The subscription is never taken from the CLI default.
PLAN_A_SUBSCRIPTION_ID=
PLAN_A_LOCATION=westeurope
PLAN_A_RESOURCE_GROUP=rg-plan-a
