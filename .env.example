# Copy to .env and fill in locally. Never commit real values.

# Engine used by the MCP server: mock (fixtures) until I1 (Sat 13:00), then real.
ENGINE=mock

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Agents: offline (deterministic rules, no Azure) or foundry (Microsoft Foundry models).
AGENTS_MODE=offline

# Microsoft Foundry (person B). Auth is Entra ID (`az login` locally, managed identity when deployed); no keys.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_LARGE=
FOUNDRY_MODEL_SMALL=
FOUNDRY_MODEL_FALLBACK=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
